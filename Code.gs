ms:center;margin-bottom:10px}@media(max-width:800px){.layout{grid-template-columns:1fr;padding:12px}.top{padding:20px 16px}}</style></head><body><header class="top"><b>BKW · ADMIN CONSOLE</b><h1>จัดการข้อมูลการศึกษาต่อ</h1><p>เพิ่มข้อมูลและ Soft Delete ผ่าน Google Sheets</p></header><main class="layout"><section class="card"><h2>เพิ่มข้อมูลนักเรียน</h2><div id="status" class="status"></div><form id="form" class="form"><label>ปีที่จบ<input id="year" required placeholder="เช่น 2567"></label><label>สถานที่เรียนต่อ<input id="university" list="universities" required autocomplete="off"><datalist id="universities"></datalist><span id="hint" class="hint">เลือกมหาวิทยาลัยเดิมเพื่อใช้โลโก้เดิม</span></label><label>ประเภท<select id="type" required><option value="">เลือกประเภท</option><option>มหาวิทยาลัย</option><option>วิทยาลัย</option><option>อื่นๆ</option></select></label><label>รูปภาพนักเรียน<input id="student" type="file" accept="image/*" required><span class="hint">แปลงเป็น WebP quality 0.8</span></label><label>โลโก้มหาวิทยาลัย<input id="logo" type="file" accept="image/*"><span id="logoHint" class="hint">มหาวิทยาลัยใหม่ต้องเลือกโลโก้</span></label><div id="preview" class="preview">ยังไม่ได้เลือกโลโก้</div><button id="save" class="btn" type="submit">บันทึกข้อมูล</button></form></section><section class="card"><div class="actions"><h2>ข้อมูลที่กำลังแสดง</h2><button id="reload" class="btn alt" type="button">รีเฟรช</button></div><div class="table-wrap"><table class="table"><thead><tr><th>ปี</th><th>สถาบัน</th><th>ประเภท</th><th>รูป</th><th>Row</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></section></main><script>const state={students:[],universities:[]},$=id=>document.getElementById(id),run=(name,...args)=>new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[name](...args));function msg(t,c){$('status').textContent=t||'';$('status').className='status '+(c||'')}function match(){const n=$('university').value.trim().toLocaleLowerCase();return state.universities.find(x=>String(x.university||'').trim().toLocaleLowerCase()===n)||null}function webp(f){return new Promise((resolve,reject)=>{if(!f)return resolve(null);const r=new FileReader();r.onerror=()=>reject(new Error('อ่านไฟล์ไม่สำเร็จ'));r.onload=()=>{const i=new Image();i.onerror=()=>reject(new Error('ไฟล์ไม่ใช่รูปภาพ'));i.onload=()=>{const c=document.createElement('canvas');c.width=i.naturalWidth;c.height=i.naturalHeight;c.getContext('2d').drawImage(i,0,0);resolve({dataUrl:c.toDataURL('image/webp',.8),name:f.name.replace(/\\.[^.]+$/,'')+'.webp'})};i.src=r.result};r.readAsDataURL(f)})}function logoMode(){const m=match();$('logo').disabled=!!m;$('logoHint').textContent=m?'พบมหาวิทยาลัยเดิม ใช้โลโก้เดิม ไม่อัปโหลดซ้ำ':'มหาวิทยาลัยใหม่ต้องเลือกโลโก้';$('preview').innerHTML=m&&m.logoUrl?'<img src="'+m.logoUrl+'">':'ยังไม่ได้เลือกโลโก้'}function draw(){ $('rows').innerHTML=state.students.length?state.students.map(x=>'<tr><td>'+x.year+'</td><td><b>'+x.institution+'</b><span class="muted">'+(x.imageUrl||'')+'</span></td><td>'+x.institutionType+'</td><td>'+(x.imageUrl?'<img class="thumb" src="'+x.imageUrl+'">':'-')+'</td><td>'+x.rowIndex+'</td><td><button class="btn delete" data-row="'+x.rowIndex+'">ลบ</button></td></tr>').join(''):'<tr><td colspan="6">ยังไม่มีข้อมูลสถานะ on</td></tr>';document.querySelectorAll('[data-row]').forEach(b=>b.onclick=async()=>{if(!confirm('ต้องการเปลี่ยนสถานะเป็น off หรือไม่?'))return;try{await run('softDeleteStudent',Number(b.dataset.row));await load();msg('ลบข้อมูลสำเร็จ','ok')}catch(e){msg(e.message,'err')}})}async function load(){state.students=await run('getStudentData');state.universities=await run('getUniqueUniversities');$('universities').innerHTML=state.universities.map(x=>'<option value="'+String(x.university).replace(/"/g,'&quot;')+'">').join('');draw();logoMode()}$('university').oninput=logoMode;$('logo').onchange=()=>{const f=$('logo').files[0];$('preview').textContent=f?f.name:'ยังไม่ได