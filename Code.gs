function health_() { const s = sheet_(), range = s.getDataRange(), values = range.getValues(), c = config_(); return { spreadsheetName: s.getParent().getName(), sheetName: s.getName(), lastRow: s.getLastRow(), lastColumn: s.getLastColumn(), headers: values.length ? values[0].map(clean_) : [], firstDataRows: values.slice(1, 4).map(r => ({ year: clean_(r[COL.YEAR]), university: clean_(r[COL.UNIVERSITY]), status: clean_(r[COL.STATUS]) })), cloudinaryConfigured: Boolean(c.cloudName && c.uploadPreset) }; }
function getUniqueUniversities() { SpreadsheetApp.flush(); const seen = new Map(); sheet_().getDataRange().getValues().slice(1).forEach(r => { const name = String(r[COL.UNIVERSITY] || '').trim(); if (name && String(r[COL.STATUS] || 'on').toLowerCase() === 'on' && !seen.has(name)) seen.set(name, { university: name, logoUrl: r[COL.LOGO] || '' }); }); return [...seen.values()].sort((a, b) => a.university.localeCompare(b.university, 'th')); }
function uploadToCloudinary_(file) { if (!file || !file.dataUrl) return ''; const c = config_(); if (!c.cloudName || !c.uploadPreset) throw new Error('Cloudinary is not configured'); const endpoint = 'https://api.cloudinary.com/v1_1/' + encodeURIComponent(c.cloudName) + '/auto/upload'; const response = UrlFetchApp.fetch(endpoint, { method: 'post', muteHttpExceptions: true, payload: { file: file.dataUrl, upload_preset: c.uploadPreset } }); const result = JSON.parse(response.getContentText()); if (response.getResponseCode() >= 300 || !result.secure_url) throw new Error(result.error && result.error.message || 'Cloudinary upload failed'); return result.secure_url; }
function nextId_(year, values) { const prefix = String(year == null ? '' : year).trim(); if (!/^\d{4}$/.test(prefix)) throw new Error('year must be exactly 4 digits'); let max = 0, yearRows = 0; values.slice(1).forEach(r => { const rowYear = String(clean_(r[COL.YEAR]) == null ? '' : clean_(r[COL.YEAR])).trim(); if (rowYear !== prefix) return; yearRows++; const id = String(clean_(r[COL.ID]) || '').trim(); const match = id.match(new RegExp('^' + prefix + '(\\d{4})$')); if (match) max = Math.max(max, Number(match[1])); }); const next = Math.max(max, yearRows) + 1; if (next > 9999) throw new Error('ID sequence is full for year ' + prefix); return prefix + String(next).padStart(4, '0'); }
function addStudentData(d) { d = d || {}; const year = String(d.year == null ? '' : d.year).trim(); const university = String(d.university || d.institution || '').trim(); if (!university || !/^\d{4}$/.test(year) || !(d.type || d.institutionType)) throw new Error('year must be 4 digits, university and type are required'); const imageUrl = clean_(d.imageUrl || d.studentImageUrl || uploadToCloudinary_(d.studentImageFile)); const logoUrl = clean_(d.logoUrl || uploadToCloudinary_(d.logoFile)); if (!imageUrl) throw new Error('student image is required'); if (!logoUrl) throw new Error('logo is required for a new university'); const timestamp = new Date(), faculty = clean_(d.faculty), s = sheet_(), lock = LockService.getScriptLock(); lock.waitLock(30000); try { const id = nextId_(year, s.getDataRange().getValues()); const row = [year, university, d.type || d.institutionType, imageUrl, logoUrl, 'on', timestamp, id, faculty]; s.appendRow(row); return rowToStudent_(row, s.getLastRow()); } finally { lock.releaseLock(); } }
