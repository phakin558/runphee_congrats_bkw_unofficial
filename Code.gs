function doPost(e) { try { const b = JSON.parse(e && e.postData && e.postData.contents || '{}'), a = b.action || b.operation; if (a === 'addStudentData') return json_({ data: addStudentData(b.formData || b.data || {}) }); if (a === 'softDeleteStudent') return json_({ data: softDeleteStudent(b.rowIndex) }); if (a === 'getStudentData') return json_({ data: getStudentData() }); if (a === 'getUniqueUniversities') return json_({ data: getUniqueUniversities() }); throw new Error('Unknown action: ' + a); } catch (e) { return error_(e); } }
