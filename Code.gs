able-wrap{overflow:auto}.table{width:100%;min-width:650px;border-collapse:collapse;font-size:13px}.table th,.table td{padding:9px 7px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:middle}.table th{color:#64748b;font-size:12px}.thumb{width:70px;height:44px;object-fit:cover;border-radius:6px}.muted{display:block;max-width:230px;color:#64748b;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.actions{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.overlay{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:#0f172acc}.busy-box,.success-box{width:min(360px,calc(100% - 32px));padding:28px;border-radius:18px;background:#fff;text-align:center;box-shadow:0 18px 50px #0005}.spinner{width:54px;height:54px;margin:0 auto 18px;border:6px solid #e0e7ff;border-top-color:#3730a3;border-radius:50%;animation:spin 1s linear infinite}.check{width:64px;height:64px;margin:0 auto 16px;border-radius:50%;color:#fff;background:#16a34a;font-size:42px;line-height:64px}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:1000px){.layout{grid-template-columns:300px minmax(0,1fr);padding:18px;gap:14px}}@media(max-width:760px){.top{padding:20px 18px}.top h1{font-size:25px}.layout{display:block;padding:12px}.card{margin-bottom:14px;padding:16px}.table-wrap{padding-bottom:4px}}@media(max-width:430px){.top h1{font-size:22px}.top p{font-size:13px}.table{min-width:620px}}</style></head><body><div id="login" class="login-wrap"><section class="login-card"><h1>เข้าสู่ระบบ Admin</h1><p>จัดการข้อมูลการศึกษาต่อ</p><form id="loginForm" class="form"><label>Username<input id="username" autocomplete="username" required></label><label>Password<input id="password" type="password" autocomplete="current-password" required></label><div id="loginError" class="status err"></div><button class="btn" type="submit">เข้าสู่ระบบ</button></form></section></div><div id="app" class="hidden"><header class="top"><b>BKW · ADMIN CONSOLE</b><h1>จัดการข้อมูลการศึกษาต่อ</h1><p>เพิ่มข้อมูลและ Soft Delete ผ่าน Google Sheets</p></header><main class="layout"><section class="card"><h2>เพิ่มข้อมูลนักเรียน</h2><div id="status" class="status"></div><form id="form" class="form"><label>ปีที่จบ<input id="year" required placeholder="เช่น 2567"></label><label>สถานที่เรียนต่อ<input id="university" list="universities" required autocomplete="off"><datalist id="universities"></datalist><span id="hint" class="hint">เลือกมหาวิทยาลัยเดิมเพื่อใช้โลโก้เดิม</span></label><label>ประเภท<select id="type" required><option value="">เลือกประเภท</option><option>มหาวิทยาลัย</option><option>วิทยาลัย</option><option>อื่นๆ</option></select></label><label>รูปภาพนักเรียน<input id="student" type="file" accept="image/*" required><span class="hint">แปลงเป็น WebP quality 0.8</span></label><label>โลโก้มหาวิทยาลัย<input id="logo" type="file" accept="image/*"><span id="logoHint" class="hint">มหาวิทยาลัยใหม่ต้องเลือกโลโก้</span></label><div id="preview" class="preview">ยังไม่ได้เลือกโลโก้</div><button id="save" class="btn" type="submit">บันทึกข้อมูล</button></form></section><section class="card"><div class="actions"><h2>ข้อมูลที่กำลังแสดง</h2><button id="reload" class="btn alt" type="button">รีเฟรช</button></div><div class="table-wrap"><table class="table"><thead><tr><th>ปี</th><th>สถาบัน</th><th>ประเภท</th><th>รูป</th><th>Row</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></section></main></div><div id="busy" class="overlay hidden"><div class="busy-box"><div class="spinner"></div><h2 id="busyText">กำลังทำงาน...</h2><p>กรุณาอย่าปิดหน้านี้</p></div></div><div id="success" class="overlay hidden"><div class="success-box"><div class="check">✓</div><h2>อัปโหลดสำเร็จ</h2><p id="successText">บันทึกข้อมูลเรียบร้อยแล้ว</p><button id="successClose" class="btn">ตกลง</button></div></div><script>let token=sessionStorage.getItem('bkw_admin_token')||'',state={students:[],universities:[]};const $=id=>document.getElementById(id),run=(name,...args)=>new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[name](...args));function busy(t){$('busyText').textContent=t;$('busy').classList.remove('hidden')}function stopBusy(){$('busy').classList.add('hidden')}function success(t){stopBusy();$('successText').textContent=t||'บันทึกข้อมูลเรียบร้อยแล้ว';$('success').classList.remove('hidden')}function msg(t,c){$('status').textContent=t||'';$('status').className='status '+(c||'')}function match(){const n=$('university').value.trim().toLocaleLowerCase();return state.universities.find(x=>String(x.university||'').trim().toLocaleLowerCase()===n)||null}function webp(f){return new Promise((resolve,reject)=>{if(!f)return resolve(null);const r=new FileReader();r.onerror=()=>reject(new Error('อ่านไฟล์ไม่สำเร็จ'));r.onload=()=>{const i=new Image();i.onerror=()=>reject(new Error('ไฟล์ไม่ใช่รูปภาพ'));i.onload=()=>{const c=document.createElement('canvas');c.width=i.naturalWidth;c.height=i.naturalHeight;c.getContext('2d').drawImage(i,0,0);resolve({dataUrl:c.toDataURL('image/webp',.8),name:f.name.replace(/\\.[^.]+$/,'')+'.webp'})};i.src=r.result};r.readAsDataURL(f)})}function logoMode(){const m=match();$('logo').disabled=!!m;$('logoHint').textContent=m?'พบมหาวิทยาลัยเดิม ใช้โลโก้เดิม ไม่อัปโหลดซ้ำ':'มหาวิทยาลัยใหม่ต้องเลือกโลโก้';$('preview').innerHTML=m&&m.logoUrl?'<img src="'+m.logoUrl+'">':'ยังไม่ได้เลือกโลโก้'}async function load(){busy('กำลังโหลดข้อมูล...');try{state.students=await run('adminGetStudentData',token);state.universities=await run('adminGetUniqueUniversities',token);$('universities').innerHTML=state.universities.map(x=>'<option value="'+String(x.university).replace(/"/g,'&quot;')+'">').join('');$('rows').innerHTML=state.students.length?state.students.map(x=>'<tr><td>'+x.year+'</td><td><b>'+x.institution+'</b><span class="muted">'+(x.imageUrl||'')+'</span></td><td>'+x.institutionType+'</td><td>'+(x.imageUrl?'<img class="thumb" src="'+x.imageUrl+'">':'-')+'</td><td>'+x.rowIndex+'</td><td><button class="btn delete" data-row="'+x.rowIndex+'">ลบ</button></td></tr>').join(''):'<tr><td colspan="6">ยังไม่มีข้อมูลสถานะ on</td></tr>';document.querySelectorAll('[data-row]').forEach(b=>b.onclick=remove);logoMode()}catch(e){if(String(e.message||e).includes('เซสชัน'))logout();else msg(e.message||e,'err')}finally{stopBusy()}}function logout(){token='';sessionStorage.removeItem('bkw_admin_token');$('app').classList.add('hidden');$('login').classList.remove('hidden')}async function remove(e){if(!confirm('ต้องการเปลี่ยนสถานะเป็น off หรือไม่?'))return;busy('กำลังลบข้อมูล...');try{await run('adminSoftDeleteStudent',token,Number(e.currentTarget.dataset.row));await load();success('ลบข้อมูลสำเร็จ')}catch(x){stopBusy();msg(x.message||x,'err')}}$('loginForm').onsubmit=async e=>{e.preventDefault();$('loginError').textContent='';try{busy('กำลังตรวจสอบ Login...');const r=await run('adminLogin',$('username').value,$('password').value);token=r.token;sessionStorage.setItem('bkw_admin_token',token);$('login').classList.add('hidden');$('app').classList.remove('hidden');await load();stopBusy()}catch(x){stopBusy();$('loginError').textContent=x.message||x}};$('university').oninput=logoMode;$('logo').onchange=()=>{const f=$('logo').files[0];$('preview').textContent=f?f.name:'ยังไม่ได้เลือกโลโก้'};$('reload').onclick=load;$('successClose').onclick=()=>{$('success').classList.add('hidden')};$('form').onsubmit=async e=>{e.preventDefault();const m=match(),student=$('student').files[0],logo=$('logo').files[0];if(!student)return msg('กรุณาเลือกรูปภาพนักเรียน','err');if(!m&&!logo)return msg('มหาวิทยาลัยใหม่ต้องเลือกโลโก้','err');$('save').disabled=true;busy('กำลังเตรียมรูปภาพ...');try{const data={year:$('year').value.trim(),university:$('university').value.trim(),type:$('type').value,studentImageFile:await webp(student),logoFile:m?null:await webp(logo),logoUrl:m?m.logoUrl:''};busy('กำลังอัปโหลดไป Cloudinary...');await run('adminAddStudentData',token,data);busy('กำลังรีเฟรชข้อมูล...');await load();$('form').reset();logoMode();success('อัปโหลดรูปและบันทึกข้อมูลลง Google Sheets แล้ว')}catch(x){stopBusy();if(String(x.message||x).includes('เซสชัน'))logout();msg(x.message||x,'err')}finally{$('save').disabled=false}};if(token){$('login').classList.add('hidden');$('app').classList.remove('hidden');load()}</script></body></html>`; }
